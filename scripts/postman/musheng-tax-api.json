{
  "info": {
    "name": "慕声税务系统 API",
    "description": "启动后端后，Base URL 为 http://localhost:8080/api",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "base_url", "value": "http://localhost:8080/api" },
    { "key": "token", "value": "" }
  ],
  "item": [
    {
      "name": "认证",
      "item": [
        {
          "name": "登录",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"your_username\",\n  \"password\": \"your_password\"\n}"
            },
            "url": "{{base_url}}/v1/auth/login"
          }
        }
      ]
    },
    {
      "name": "配置",
      "item": [
        {
          "name": "货币列表",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": "{{base_url}}/v1/config/currencies"
          }
        },
        {
          "name": "市场列表",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": "{{base_url}}/v1/config/marketplaces"
          }
        }
      ]
    },
    {
      "name": "业务",
      "item": [
        {
          "name": "销售列表（示例）",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": "{{base_url}}/v1/business/sales/list"
          }
        }
      ]
    }
  ]
}
